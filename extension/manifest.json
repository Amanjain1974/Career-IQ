{
  "manifest_version": 3,
  "name": "CareerIQ Job Saver",
  "version": "1.0",
  "description": "Save jobs from anywhere to CareerIQ",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:8000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}
